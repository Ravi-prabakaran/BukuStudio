# Copy to .env and fill in. Never commit .env.
# BukuStudio also reads ~/.config/bukustudio/.env and a .env in your working folder.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Which service makes pictures: openai, gemini, or fake (offline test images).
# BUKU_IMAGE_PROVIDER=gemini
# Optional model overrides; otherwise the newest suitable model is picked.
# BUKU_OPENAI_MODEL=
# BUKU_GEMINI_MODEL=
